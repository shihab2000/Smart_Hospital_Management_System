@model SHMS.Models.LabReport

@{
    ViewData["Title"] = "Lab Report";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Lab Report - @(Model?.LabTest?.Patient?.Name ?? "Patient")</title>
    <style>
        :root {
            --brand-primary: #0d9488;
            --brand-secondary: #0369a1;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #1e293b;
            max-width: 800px;
            margin: 0 auto;
            padding: 40px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 3px solid var(--brand-primary);
            padding-bottom: 16px;
            margin-bottom: 24px;
        }

        .header h1 {
            font-size: 22px;
            margin: 0;
            color: var(--brand-secondary);
        }

        .header p {
            margin: 2px 0 0;
            font-size: 13px;
            color: #64748b;
        }

        .report-title {
            text-align: center;
            font-size: 18px;
            font-weight: 700;
            margin: 24px 0;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        table.info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 24px;
        }

        table.info-table td {
            padding: 6px 8px;
            font-size: 14px;
            border-bottom: 1px solid #e2e8f0;
        }

        table.info-table td.label {
            font-weight: 600;
            width: 160px;
            color: #475569;
        }

        .result-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .result-box h3 {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #64748b;
            margin: 0 0 8px;
        }

        .result-box p {
            margin: 0;
            font-size: 15px;
            line-height: 1.6;
        }

        .footer {
            margin-top: 60px;
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #94a3b8;
            border-top: 1px solid #e2e8f0;
            padding-top: 16px;
        }

        .print-bar {
            text-align: center;
            margin-bottom: 24px;
        }

        .print-bar button {
            background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
            color: #fff;
            border: none;
            padding: 10px 24px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            font-size: 14px;
        }

        @@media print {
            .print-bar {
                display: none;
            }
            body {
                padding: 0;
            }
        }
    </style>
</head>
<body>

    <div class="print-bar">
        <button onclick="window.print()">🖨️ Print / Save as PDF</button>
    </div>

    <div class="header">
        <div>
            <h1>SHMS</h1>
            <p>Smart Hospital Management System</p>
        </div>
        <div style="text-align:right;">
            <p>Report Date: @Model?.ReportDate.ToString("dd MMM yyyy")</p>
            <p>Report ID: LR-@Model?.LabReportId.ToString("D5")</p>
        </div>
    </div>

    <div class="report-title">Laboratory Test Report</div>

    <table class="info-table">
        <tr>
            <td class="label">Patient Name</td>
            <td>@(Model?.LabTest?.Patient?.Name ?? "—")</td>
            <td class="label">Blood Group</td>
            <td>@(Model?.LabTest?.Patient?.BloodGroup ?? "—")</td>
        </tr>
        <tr>
            <td class="label">Gender</td>
            <td>@(Model?.LabTest?.Patient?.Gender ?? "—")</td>
            <td class="label">Phone</td>
            <td>@(Model?.LabTest?.Patient?.Phone ?? "—")</td>
        </tr>
        <tr>
            <td class="label">Test Name</td>
            <td>@(Model?.LabTest?.TestName ?? "—")</td>
            <td class="label">Test Date</td>
            <td>@(Model?.LabTest?.TestDate.ToString("dd MMM yyyy") ?? "—")</td>
        </tr>
    </table>

    <div class="result-box">
        <h3>Result</h3>
        <p>@Model?.Result</p>
    </div>

    @if (!string.IsNullOrEmpty(Model?.Remarks))
    {
        <div class="result-box">
            <h3>Remarks</h3>
            <p>@Model.Remarks</p>
        </div>
    }

    <div class="footer">
        <span>Generated by SHMS on @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")</span>
        <span>This is a system-generated report.</span>
    </div>

</body>
</html>