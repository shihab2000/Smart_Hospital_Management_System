@model SHMS.Models.InventoryItem

@{
    ViewData["Title"] = "Details";
    var isLow = Model != null && Model.Quantity < Model.MinimumStock;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-3 text-white fs-4"
                         style="width:64px;height:64px;background:linear-gradient(135deg, var(--brand-secondary), var(--brand-primary));">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold">@Html.DisplayFor(model => model.ItemName)</h1>
                        <p class="text-muted small mb-0">@Html.DisplayFor(model => model.ItemType)</p>
                    </div>
                </div>

                <hr class="mb-4" />

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-boxes me-2"></i>@Html.DisplayNameFor(model => model.Quantity)
                    </dt>
                    <dd class="col-sm-8">
                        <span class="badge rounded-pill @(isLow ? "text-bg-warning" : "text-bg-light border")">
                            @Model?.Quantity @Model?.Unit
                            @if (isLow)
                            {
                                <i class="bi bi-exclamation-triangle-fill ms-1"></i>
                            }
                        </span>
                    </dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-rulers me-2"></i>@Html.DisplayNameFor(model => model.Unit)
                    </dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Unit)</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-arrow-down-circle me-2"></i>@Html.DisplayNameFor(model => model.MinimumStock)
                    </dt>
                    <dd class="col-sm-8">@Model?.MinimumStock @Model?.Unit</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-circle-fill me-2" style="font-size:.6rem;"></i>@Html.DisplayNameFor(model => model.Status)
                    </dt>
                    <dd class="col-sm-8">
                        @{
                            var statusClass = Model?.Status?.ToLower() switch
                            {
                                "available" => "text-bg-success",
                                "low stock" => "text-bg-warning",
                                "out of stock" => "text-bg-danger",
                                _ => "text-bg-secondary"
                            };
                        }
                        <span class="badge rounded-pill @statusClass">@Model?.Status</span>
                    </dd>
                </dl>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.InventoryItemId" class="btn btn-primary flex-fill fw-semibold">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }
</style>