@model SHMS.Models.Purchase

@{
    ViewData["Title"] = "Create";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-3 text-white"
                         style="width:48px;height:48px;background:linear-gradient(135deg, var(--brand-secondary), var(--brand-primary));">
                        <i class="bi bi-cart-plus fs-5"></i>
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold">Record Purchase</h1>
                        <p class="text-muted small mb-0">Log a new medicine purchase from a supplier.</p>
                    </div>
                </div>

                <hr class="mb-4" />

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="d-flex gap-2 align-items-end">
                                <div class="form-floating flex-fill">
                                    <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.SupplierId" id="supplierSelect">
                                        <option value="">-- Select Supplier --</option>
                                    </select>
                                    <label asp-for="SupplierId"></label>
                                    <span asp-validation-for="SupplierId" class="text-danger small"></span>
                                </div>
                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#quickAddSupplierModal" title="Add New Supplier">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="MedicineId" class="form-select" asp-items="ViewBag.MedicineId">
                                    <option value="">-- Select Medicine --</option>
                                </select>
                                <label asp-for="MedicineId"></label>
                                <span asp-validation-for="MedicineId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="PurchaseDate" type="date" class="form-control" />
                                <label asp-for="PurchaseDate"></label>
                                <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Quantity" type="number" class="form-control" placeholder="Quantity" />
                                <label asp-for="Quantity"></label>
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="TotalAmount" type="number" step="0.01" class="form-control" placeholder="Total Amount" />
                                <label asp-for="TotalAmount"></label>
                                <span asp-validation-for="TotalAmount" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary flex-fill py-2 fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Create
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-2">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    </div>
                </form>

            </div>
        </div>

        <div class="text-center mt-3">
            <a asp-action="Index" class="text-decoration-none small">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>
</div>

<!-- Quick Add Supplier Modal -->
<div class="modal fade" id="quickAddSupplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-truck me-2"></i>Add New Supplier
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="quickAddError" class="alert alert-danger py-2 small d-none"></div>
                <div class="form-floating mb-3">
                    <input type="text" id="qsName" class="form-control" placeholder="Supplier name" />
                    <label>Supplier Name *</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="text" id="qsPhone" class="form-control" placeholder="Phone" />
                    <label>Phone</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="email" id="qsEmail" class="form-control" placeholder="Email" />
                    <label>Email</label>
                </div>
                <div class="form-floating">
                    <textarea id="qsAddress" class="form-control" placeholder="Address" style="height:80px"></textarea>
                    <label>Address</label>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary fw-semibold" id="quickAddSubmit">
                    <i class="bi bi-check-circle me-1"></i> Add Supplier
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 .2rem rgba(13, 148, 136, .15);
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.getElementById('quickAddSubmit').addEventListener('click', async function () {
            const name = document.getElementById('qsName').value.trim();
            const phone = document.getElementById('qsPhone').value.trim();
            const email = document.getElementById('qsEmail').value.trim();
            const address = document.getElementById('qsAddress').value.trim();
            const errorBox = document.getElementById('quickAddError');
            errorBox.classList.add('d-none');

            if (!name) {
                errorBox.textContent = 'Supplier name is required.';
                errorBox.classList.remove('d-none');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const formData = new URLSearchParams();
            formData.append('supplierName', name);
            formData.append('phone', phone);
            formData.append('email', email);
            formData.append('address', address);

            try {
                const response = await fetch('@Url.Action("QuickAddSupplier", "Purchases")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                if (!response.ok) {
                    const err = await response.json();
                    errorBox.textContent = err.message || 'Failed to add supplier.';
                    errorBox.classList.remove('d-none');
                    return;
                }

                const data = await response.json();

                const select = document.getElementById('supplierSelect');
                const option = document.createElement('option');
                option.value = data.supplierId;
                option.text = data.supplierName;
                option.selected = true;
                select.appendChild(option);

                document.getElementById('qsName').value = '';
                document.getElementById('qsPhone').value = '';
                document.getElementById('qsEmail').value = '';
                document.getElementById('qsAddress').value = '';

                var modalEl = document.getElementById('quickAddSupplierModal');
                var modal = bootstrap.Modal.getInstance(modalEl);
                modal.hide();
            } catch (err) {
                errorBox.textContent = 'Something went wrong. Please try again.';
                errorBox.classList.remove('d-none');
            }
        });
    </script>
}