@model IEnumerable<SHMS.Models.MedicalRecord>

@{
    ViewData["Title"] = "Medical Records";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Medical Records</h1>
        <p class="text-muted small mb-0">Patient symptoms, diagnoses, and treatment history.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold">
        <i class="bi bi-plus-lg me-1"></i> Create New
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">@Html.DisplayNameFor(model => model.Patient)</th>
                    <th>@Html.DisplayNameFor(model => model.Doctor)</th>
                    <th>@Html.DisplayNameFor(model => model.Diagnosis)</th>
                    <th>@Html.DisplayNameFor(model => model.Treatment)</th>
                    <th>@Html.DisplayNameFor(model => model.RecordDate)</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="ps-4 fw-semibold">@(item.Patient?.Name ?? "—")</td>
                    <td class="text-muted">@(item.Doctor?.Name ?? "—")</td>
                    <td class="text-muted">@item.Diagnosis</td>
                    <td class="text-muted">@item.Treatment</td>
                    <td>@item.RecordDate.ToString("dd MMM yyyy")</td>
                    <td class="text-end pe-4">
                        <a asp-action="Details" asp-route-id="@item.MedicalRecordId" class="btn btn-sm btn-outline-secondary border-0" title="Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.MedicalRecordId" class="btn btn-sm btn-outline-primary border-0" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.MedicalRecordId" class="btn btn-sm btn-outline-danger border-0" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-file-medical display-6 d-block mb-2"></i>
        No medical records found.
    </div>
}

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }

    .table > :not(caption) > * > * {
        padding-top: .9rem;
        padding-bottom: .9rem;
    }
</style>