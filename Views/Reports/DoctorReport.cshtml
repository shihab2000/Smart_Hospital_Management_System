@model IEnumerable<SHMS.Controllers.DoctorReportRow>

@{
    ViewData["Title"] = "Doctor Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h1 class="h3 fw-bold mb-1">Doctor Report</h1>
        <p class="text-muted small mb-0">Doctor list with appointment counts in range.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> All Reports
    </a>
</div>

<div class="no-print">
    @await Html.PartialAsync("_DateFilter", null, new ViewDataDictionary(ViewData) { ["ActionName"] = "DoctorReport" })
</div>

<div class="alert alert-light border mb-3 print-header">
    <strong>SHMS — Doctor Report</strong> · Generated @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Name</th>
                    <th>Department</th>
                    <th>Specialization</th>
                    <th>Availability</th>
                    <th class="pe-4">Appointments (in range)</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="ps-4 fw-semibold">@item.Name</td>
                    <td class="text-muted">@item.DepartmentName</td>
                    <td class="text-muted">@item.Specialization</td>
                    <td>
                        <span class="badge rounded-pill @(item.Availability ? "text-bg-success" : "text-bg-secondary")">
                            @(item.Availability ? "Available" : "Unavailable")
                        </span>
                    </td>
                    <td class="pe-4">
                        <span class="badge rounded-pill text-bg-light border">@item.AppointmentCount</span>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-person-badge display-6 d-block mb-2"></i>
        No doctors found.
    </div>
}

<style>
    @@media print {
        .no-print { display: none !important; }
        .print-header { display: block !important; }
    }
    .print-header { display: none; }
</style>