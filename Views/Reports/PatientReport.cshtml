@model IEnumerable<SHMS.Models.Patient>

@{
    ViewData["Title"] = "Patient Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h1 class="h3 fw-bold mb-1">Patient Report</h1>
        <p class="text-muted small mb-0">Full list of registered patients.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> All Reports
    </a>
</div>

<div class="no-print">
    @await Html.PartialAsync("_DateFilter", null, new ViewDataDictionary(ViewData) { ["ActionName"] = "PatientReport" })
</div>

<div class="alert alert-light border mb-3 print-header">
    <strong>SHMS — Patient Report</strong> · Generated @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
</div>

<div class="row g-3 mb-3 no-print">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-4 fw-bold text-primary">@ViewBag.TotalPatients</div>
                <div class="small text-muted">Total Patients</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Name</th>
                    <th>Date of Birth</th>
                    <th>Gender</th>
                    <th>Phone</th>
                    <th>Blood Group</th>
                    <th class="pe-4">Address</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="ps-4 fw-semibold">@item.Name</td>
                    <td>@item.DateOfBirth.ToString("dd MMM yyyy")</td>
                    <td>@item.Gender</td>
                    <td class="text-muted">@item.Phone</td>
                    <td>
                        <span class="badge rounded-pill text-bg-danger-subtle text-danger-emphasis border border-danger-subtle">
                            @(item.BloodGroup ?? "—")
                        </span>
                    </td>
                    <td class="pe-4 text-muted">@item.Address</td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-people display-6 d-block mb-2"></i>
        No patients found.
    </div>
}

<style>
    @@media print {
        .no-print { display: none !important; }
        .print-header { display: block !important; }
    }
    .print-header { display: none; }
</style>