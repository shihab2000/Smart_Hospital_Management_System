@model IEnumerable<SHMS.Models.Purchase>

@{
    ViewData["Title"] = "Pharmacy Report";
    var sales = ViewBag.Sales as List<SHMS.Models.Sale>;
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h1 class="h3 fw-bold mb-1">Pharmacy Report</h1>
        <p class="text-muted small mb-0">Medicine purchases and sales in the selected range.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> All Reports
    </a>
</div>

<div class="no-print">
    @await Html.PartialAsync("_DateFilter", null, new ViewDataDictionary(ViewData) { ["ActionName"] = "PharmacyReport" })
</div>

<div class="alert alert-light border mb-3 print-header">
    <strong>SHMS — Pharmacy Report</strong> · Generated @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
</div>

<div class="row g-3 mb-3 no-print">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-4 fw-bold text-primary">৳@(((decimal)ViewBag.TotalPurchaseAmount).ToString("0.00"))</div>
                <div class="small text-muted">Total Purchases</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-4 fw-bold text-success">৳@(((decimal)ViewBag.TotalSaleAmount).ToString("0.00"))</div>
                <div class="small text-muted">Total Sales</div>
            </div>
        </div>
    </div>
</div>

<h6 class="fw-bold mb-2"><i class="bi bi-cart-check me-2"></i>Purchases</h6>
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Medicine</th>
                    <th>Supplier</th>
                    <th>Date</th>
                    <th>Quantity</th>
                    <th class="pe-4">Amount</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="ps-4 fw-semibold">@(item.Medicine?.MedicineName ?? "—")</td>
                    <td class="text-muted">@(item.Supplier?.SupplierName ?? "—")</td>
                    <td>@item.PurchaseDate.ToString("dd MMM yyyy")</td>
                    <td>@item.Quantity</td>
                    <td class="pe-4">৳@item.TotalAmount.ToString("0.00")</td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

<h6 class="fw-bold mb-2"><i class="bi bi-cash-coin me-2"></i>Sales</h6>
<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Medicine</th>
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Quantity</th>
                    <th class="pe-4">Amount</th>
                </tr>
            </thead>
            <tbody>
@if (sales != null) {
    @foreach (var item in sales) {
                <tr>
                    <td class="ps-4 fw-semibold">@(item.Medicine?.MedicineName ?? "—")</td>
                    <td class="text-muted">@(item.Patient?.Name ?? "—")</td>
                    <td>@item.SaleDate.ToString("dd MMM yyyy")</td>
                    <td>@item.Quantity</td>
                    <td class="pe-4">৳@item.TotalAmount.ToString("0.00")</td>
                </tr>
    }
}
            </tbody>
        </table>
    </div>
</div>

<style>
    @@media print {
        .no-print { display: none !important; }
        .print-header { display: block !important; }
    }
    .print-header { display: none; }
</style>