@model IEnumerable<SHMS.Models.Admission>

@{
    ViewData["Title"] = "Admission Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h1 class="h3 fw-bold mb-1">Admission Report</h1>
        <p class="text-muted small mb-0">Admissions and discharges in the selected range.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> All Reports
    </a>
</div>

<div class="no-print">
    @await Html.PartialAsync("_DateFilter", null, new ViewDataDictionary(ViewData) { ["ActionName"] = "AdmissionReport" })
</div>

<div class="alert alert-light border mb-3 print-header">
    <strong>SHMS — Admission Report</strong> · Generated @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
</div>

<div class="row g-3 mb-3 no-print">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-4 fw-bold text-primary">@ViewBag.AdmittedCount</div>
                <div class="small text-muted">Currently Admitted</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-4 fw-bold text-secondary">@ViewBag.DischargedCount</div>
                <div class="small text-muted">Discharged</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Patient</th>
                    <th>Ward</th>
                    <th>Bed</th>
                    <th>Admission Date</th>
                    <th>Discharge Date</th>
                    <th class="pe-4">Status</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="ps-4 fw-semibold">@(item.Patient?.Name ?? "—")</td>
                    <td class="text-muted">@(item.Ward?.WardName ?? "—")</td>
                    <td class="text-muted">@(item.Bed?.BedNumber ?? "—")</td>
                    <td>@item.AdmissionDate.ToString("dd MMM yyyy")</td>
                    <td class="text-muted">@(item.DischargeDate?.ToString("dd MMM yyyy") ?? "—")</td>
                    <td class="pe-4">
                        <span class="badge rounded-pill @(item.Status == "Admitted" ? "text-bg-primary" : "text-bg-secondary")">
                            @item.Status
                        </span>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-clipboard2-check display-6 d-block mb-2"></i>
        No admissions in this date range.
    </div>
}

<style>
    @@media print {
        .no-print { display: none !important; }
        .print-header { display: block !important; }
    }
    .print-header { display: none; }
</style>