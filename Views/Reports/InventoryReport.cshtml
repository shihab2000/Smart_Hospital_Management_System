@model IEnumerable<SHMS.Models.InventoryItem>

@{
    ViewData["Title"] = "Inventory Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h1 class="h3 fw-bold mb-1">Inventory Report</h1>
        <p class="text-muted small mb-0">Full stock status across all items.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> All Reports
    </a>
</div>

<div class="alert alert-light border mb-3 print-header">
    <strong>SHMS — Inventory Report</strong> · Generated @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
</div>

<div class="row g-3 mb-3 no-print">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-4 fw-bold text-primary">@Model.Count()</div>
                <div class="small text-muted">Total Items</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-4 fw-bold text-warning">@ViewBag.LowStockCount</div>
                <div class="small text-muted">Low Stock Items</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Item Name</th>
                    <th>Type</th>
                    <th>Quantity</th>
                    <th>Min. Stock</th>
                    <th class="pe-4">Status</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                var isLow = item.Quantity < item.MinimumStock;
                <tr class="@(isLow ? "table-warning" : "")">
                    <td class="ps-4 fw-semibold">@item.ItemName</td>
                    <td class="text-muted">@item.ItemType</td>
                    <td>@item.Quantity @item.Unit</td>
                    <td class="text-muted">@item.MinimumStock @item.Unit</td>
                    <td class="pe-4">
                        <span class="badge rounded-pill @(isLow ? "text-bg-warning" : "text-bg-success")">
                            @(isLow ? "Low Stock" : item.Status)
                        </span>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-box-seam display-6 d-block mb-2"></i>
        No inventory items found.
    </div>
}

<style>
    @@media print {
        .no-print { display: none !important; }
        .print-header { display: block !important; }
    }
    .print-header { display: none; }
</style>