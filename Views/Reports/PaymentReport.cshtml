@model IEnumerable<SHMS.Models.Payment>

@{
    ViewData["Title"] = "Payment Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h1 class="h3 fw-bold mb-1">Payment Report</h1>
        <p class="text-muted small mb-0">All payments received in the selected range.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> All Reports
    </a>
</div>

<div class="no-print">
    @await Html.PartialAsync("_DateFilter", null, new ViewDataDictionary(ViewData) { ["ActionName"] = "PaymentReport" })
</div>

<div class="alert alert-light border mb-3 print-header">
    <strong>SHMS — Payment Report</strong> · Generated @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
</div>

<div class="row g-3 mb-3 no-print">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-5 fw-bold text-primary">৳@(((decimal)ViewBag.TotalAmount).ToString("0.00"))</div>
                <div class="small text-muted">Total Collected</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-5 fw-bold">৳@(((decimal)ViewBag.CashTotal).ToString("0.00"))</div>
                <div class="small text-muted">Cash</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-5 fw-bold">৳@(((decimal)ViewBag.CardTotal).ToString("0.00"))</div>
                <div class="small text-muted">Card</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-5 fw-bold">৳@(((decimal)ViewBag.MobileTotal).ToString("0.00"))</div>
                <div class="small text-muted">Mobile Banking</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Patient</th>
                    <th>Invoice</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th class="pe-4">Method</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="ps-4 fw-semibold">@(item.Invoice?.Patient?.Name ?? "—")</td>
                    <td class="text-muted">INV-@item.InvoiceId.ToString("D5")</td>
                    <td>@item.PaymentDate.ToString("dd MMM yyyy")</td>
                    <td>৳@item.Amount.ToString("0.00")</td>
                    <td class="pe-4">
                        <span class="badge rounded-pill text-bg-light border">@item.PaymentMethod</span>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-cash-stack display-6 d-block mb-2"></i>
        No payments in this date range.
    </div>
}

<style>
    @@media print {
        .no-print { display: none !important; }
        .print-header { display: block !important; }
    }
    .print-header { display: none; }
</style>