@model IEnumerable<SHMS.Models.MedicalRecord>

@{
    ViewData["Title"] = "Medical Record Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h1 class="h3 fw-bold mb-1">Medical Record Report</h1>
        <p class="text-muted small mb-0">Diagnoses and treatments in the selected range.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> All Reports
    </a>
</div>

<div class="no-print">
    @await Html.PartialAsync("_DateFilter", null, new ViewDataDictionary(ViewData) { ["ActionName"] = "MedicalRecordReport" })
</div>

<div class="alert alert-light border mb-3 print-header">
    <strong>SHMS — Medical Record Report</strong> · Generated @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Patient</th>
                    <th>Doctor</th>
                    <th>Date</th>
                    <th>Diagnosis</th>
                    <th class="pe-4">Treatment</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="ps-4 fw-semibold">@(item.Patient?.Name ?? "—")</td>
                    <td class="text-muted">@(item.Doctor?.Name ?? "—")</td>
                    <td>@item.RecordDate.ToString("dd MMM yyyy")</td>
                    <td class="text-muted">@item.Diagnosis</td>
                    <td class="pe-4 text-muted">@item.Treatment</td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-file-medical display-6 d-block mb-2"></i>
        No medical records in this date range.
    </div>
}

<style>
    @@media print {
        .no-print { display: none !important; }
        .print-header { display: block !important; }
    }
    .print-header { display: none; }
</style>