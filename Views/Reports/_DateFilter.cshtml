@{
    string actionName = ViewData["ActionName"] as string ?? "";
    string filterType = ViewBag.FilterType ?? "monthly";
    DateTime startDate = ViewBag.StartDate;
    DateTime endDate = ViewBag.EndDate;
}

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body p-3">
        <form method="get" asp-action="@actionName" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small text-muted mb-1">Filter</label>
                <select name="filterType" class="form-select form-select-sm" onchange="toggleCustomRange(this.value)">
                    <option value="daily" selected="@(filterType == "daily")">Daily</option>
                    <option value="weekly" selected="@(filterType == "weekly")">Weekly</option>
                    <option value="monthly" selected="@(filterType == "monthly")">Monthly</option>
                    <option value="custom" selected="@(filterType == "custom")">Custom Range</option>
                </select>
            </div>
            <div class="col-auto custom-range-field" style="display:@(filterType == "custom" ? "block" : "none");">
                <label class="form-label small text-muted mb-1">From</label>
                <input type="date" name="startDate" class="form-control form-control-sm" value="@startDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-auto custom-range-field" style="display:@(filterType == "custom" ? "block" : "none");">
                <label class="form-label small text-muted mb-1">To</label>
                <input type="date" name="endDate" class="form-control form-control-sm" value="@endDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="bi bi-funnel me-1"></i> Apply
                </button>
            </div>
            <div class="col-auto">
                <a href="#" onclick="window.print(); return false;" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-printer me-1"></i> Print
                </a>
            </div>
        </form>
        <p class="text-muted small mt-2 mb-0">
            Showing: <strong>@startDate.ToString("dd MMM yyyy")</strong> to <strong>@endDate.ToString("dd MMM yyyy")</strong>
        </p>
    </div>
</div>

<script>
    function toggleCustomRange(value) {
        document.querySelectorAll('.custom-range-field').forEach(el => {
            el.style.display = value === 'custom' ? 'block' : 'none';
        });
    }
</script>

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }
</style>