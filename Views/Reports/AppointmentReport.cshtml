@model IEnumerable<SHMS.Models.Appointment>

@{
    ViewData["Title"] = "Appointment Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h1 class="h3 fw-bold mb-1">Appointment Report</h1>
        <p class="text-muted small mb-0">Appointments within the selected date range.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> All Reports
    </a>
</div>

<div class="no-print">
    @await Html.PartialAsync("_DateFilter", null, new ViewDataDictionary(ViewData) { ["ActionName"] = "AppointmentReport" })
</div>

<div class="alert alert-light border mb-3 print-header">
    <strong>SHMS — Appointment Report</strong> · Generated @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
</div>

<div class="row g-3 mb-3 no-print">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-4 fw-bold text-warning">@ViewBag.Pending</div>
                <div class="small text-muted">Pending</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-4 fw-bold text-success">@ViewBag.Confirmed</div>
                <div class="small text-muted">Confirmed</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-4 fw-bold text-primary">@ViewBag.Completed</div>
                <div class="small text-muted">Completed</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-3">
                <div class="fs-4 fw-bold text-danger">@ViewBag.Cancelled</div>
                <div class="small text-muted">Cancelled</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Patient</th>
                    <th>Doctor</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th class="pe-4">Status</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="ps-4 fw-semibold">@(item.Patient?.Name ?? "—")</td>
                    <td class="text-muted">@(item.Doctor?.Name ?? "—")</td>
                    <td>@item.AppointmentDate.ToString("dd MMM yyyy")</td>
                    <td class="text-muted">@item.AppointmentTime.ToString(@"hh\:mm")</td>
                    <td class="pe-4">
                        @{
                            var statusClass = item.Status?.ToLower() switch
                            {
                                "confirmed" => "text-bg-success",
                                "completed" => "text-bg-primary",
                                "cancelled" => "text-bg-danger",
                                "pending" => "text-bg-warning",
                                _ => "text-bg-secondary"
                            };
                        }
                        <span class="badge rounded-pill @statusClass">@item.Status</span>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-calendar-check display-6 d-block mb-2"></i>
        No appointments in this date range.
    </div>
}

<style>
    @@media print {
        .no-print { display: none !important; }
        .print-header { display: block !important; }
    }
    .print-header { display: none; }
</style>