@model IEnumerable<SHMS.Models.Payment>

@{
    ViewData["Title"] = "Payments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Payments</h1>
        <p class="text-muted small mb-0">View payment history across all invoices.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold">
        <i class="bi bi-plus-lg me-1"></i> Record Payment
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Patient</th>
                    <th>Invoice</th>
                    <th>@Html.DisplayNameFor(model => model.PaymentDate)</th>
                    <th>@Html.DisplayNameFor(model => model.Amount)</th>
                    <th>@Html.DisplayNameFor(model => model.PaymentMethod)</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="ps-4 fw-semibold">@(item.Invoice?.Patient?.Name ?? "—")</td>
                    <td class="text-muted">INV-@item.InvoiceId.ToString("D5")</td>
                    <td>@item.PaymentDate.ToString("dd MMM yyyy")</td>
                    <td class="text-muted">৳@item.Amount.ToString("0.00")</td>
                    <td>
                        <span class="badge rounded-pill text-bg-light border">
                            <i class="bi bi-@(item.PaymentMethod == "Cash" ? "cash" : item.PaymentMethod == "Card" ? "credit-card" : "phone") me-1"></i>
                            @item.PaymentMethod
                        </span>
                    </td>
                    <td class="text-end pe-4">
                        <a asp-action="Details" asp-route-id="@item.PaymentId" class="btn btn-sm btn-outline-secondary border-0" title="Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.PaymentId" class="btn btn-sm btn-outline-danger border-0" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-cash-stack display-6 d-block mb-2"></i>
        No payments recorded yet.
    </div>
}

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }

    .table > :not(caption) > * > * {
        padding-top: .9rem;
        padding-bottom: .9rem;
    }
</style>