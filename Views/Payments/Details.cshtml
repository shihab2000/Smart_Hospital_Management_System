@model SHMS.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-3 text-white fs-4"
                         style="width:64px;height:64px;background:linear-gradient(135deg, var(--brand-secondary), var(--brand-primary));">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold">৳@Model?.Amount.ToString("0.00")</h1>
                        <p class="text-muted small mb-0">
                            @(Model?.Invoice?.Patient?.Name ?? "—") · @Model?.PaymentDate.ToString("dd MMM yyyy")
                        </p>
                    </div>
                </div>

                <hr class="mb-4" />

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-receipt me-2"></i>Invoice
                    </dt>
                    <dd class="col-sm-8">
                        <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model?.InvoiceId">
                            INV-@Model?.InvoiceId.ToString("D5")
                        </a>
                    </dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-person me-2"></i>Patient
                    </dt>
                    <dd class="col-sm-8">@(Model?.Invoice?.Patient?.Name ?? "—")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-calendar3 me-2"></i>@Html.DisplayNameFor(model => model.PaymentDate)
                    </dt>
                    <dd class="col-sm-8">@Model?.PaymentDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-cash me-2"></i>@Html.DisplayNameFor(model => model.Amount)
                    </dt>
                    <dd class="col-sm-8 fw-bold">৳@Model?.Amount.ToString("0.00")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-credit-card me-2"></i>@Html.DisplayNameFor(model => model.PaymentMethod)
                    </dt>
                    <dd class="col-sm-8">
                        <span class="badge rounded-pill text-bg-light border">@Model?.PaymentMethod</span>
                    </dd>
                </dl>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <a asp-controller="Invoices" asp-action="Details" asp-route-id="@Model?.InvoiceId" class="btn btn-primary flex-fill fw-semibold">
                        <i class="bi bi-receipt me-1"></i> View Invoice
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }
</style>