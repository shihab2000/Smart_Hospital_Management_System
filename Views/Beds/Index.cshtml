@model IEnumerable<SHMS.Models.Bed>

@{
    ViewData["Title"] = "Beds";
    var availableOnly = ViewData["AvailableOnly"] as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Beds</h1>
        <p class="text-muted small mb-0">Manage beds across all wards.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold">
        <i class="bi bi-plus-lg me-1"></i> Create New
    </a>
</div>

<div class="d-flex gap-2 mb-3">
    <a asp-action="Index" asp-route-availableOnly="false"
       class="btn btn-sm @(availableOnly ? "btn-outline-secondary" : "btn-secondary")">
        All Beds
    </a>
    <a asp-action="Index" asp-route-availableOnly="true"
       class="btn btn-sm @(availableOnly ? "btn-success" : "btn-outline-success")">
        <i class="bi bi-check-circle me-1"></i> Available Beds Only
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">@Html.DisplayNameFor(model => model.Ward)</th>
                    <th>@Html.DisplayNameFor(model => model.BedNumber)</th>
                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="ps-4 fw-semibold">@(item.Ward?.WardName ?? "—")</td>
                    <td class="text-muted">@item.BedNumber</td>
                    <td>
                        <span class="badge rounded-pill @(item.Status == "Available" ? "text-bg-success" : "text-bg-danger")">
                            @item.Status
                        </span>
                    </td>
                    <td class="text-end pe-4">
                        <a asp-action="Details" asp-route-id="@item.BedId" class="btn btn-sm btn-outline-secondary border-0" title="Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.BedId" class="btn btn-sm btn-outline-primary border-0" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.BedId" class="btn btn-sm btn-outline-danger border-0" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-file-earmark-ruled display-6 d-block mb-2"></i>
        @(availableOnly ? "No available beds right now." : "No beds found.")
    </div>
}

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }

    .table > :not(caption) > * > * {
        padding-top: .9rem;
        padding-bottom: .9rem;
    }
</style>