@model IEnumerable<SHMS.Models.LabTest>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Patient)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TestName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TestDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TestStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TestFee)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Patient.Gender)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TestName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TestDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TestStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TestFee)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.LabTestId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.LabTestId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.LabTestId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
