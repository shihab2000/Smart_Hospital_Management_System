@{
    ViewData["Title"] = "Home Page";
}

<style>
    .hero-shms {
        background: linear-gradient(120deg, var(--brand-secondary) 0%, var(--brand-primary) 100%);
        border-radius: 18px;
        padding: 3.5rem 2rem;
        color: #fff;
        position: relative;
        overflow: hidden;
        margin-bottom: 2.5rem;
    }

    .hero-shms::after {
        content: "";
        position: absolute;
        right: -60px;
        top: -60px;
        width: 260px;
        height: 260px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 50%;
    }

    .hero-shms i.bi-heart-pulse {
        font-size: 3rem;
        opacity: .9;
        margin-bottom: .5rem;
    }

    .hero-shms h1 {
        font-weight: 700;
        font-size: 2.4rem;
        margin-bottom: .5rem;
    }

    .hero-shms p.lead {
        color: rgba(255, 255, 255, 0.9);
        max-width: 620px;
        margin: 0 auto 1.5rem;
    }

    .hero-shms .btn-hero {
        background: #fff;
        color: var(--brand-secondary);
        font-weight: 600;
        border-radius: 10px;
        padding: .6rem 1.6rem;
        border: none;
        transition: transform .2s ease;
    }

    .hero-shms .btn-hero:hover {
        transform: translateY(-2px);
        color: var(--brand-secondary);
    }

    /* Feature cards */
    .feature-card {
        background: #fff;
        border-radius: 14px;
        padding: 1.75rem 1.5rem;
        height: 100%;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
        border: 1px solid rgba(15, 23, 42, 0.04);
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .feature-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.1);
    }

    .feature-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #fff;
        margin-bottom: 1rem;
    }

    .bg-teal { background: var(--brand-primary); }
    .bg-blue { background: var(--brand-secondary); }
    .bg-purple { background: #7c3aed; }
    .bg-amber { background: #d97706; }

    .feature-card h5 {
        font-weight: 600;
        margin-bottom: .4rem;
    }

    .feature-card p {
        color: #64748b;
        font-size: .92rem;
        margin-bottom: 0;
    }
</style>

<div class="hero-shms text-center">
    <i class="bi bi-heart-pulse"></i>
    <h1>Smart Hospital Management System</h1>
    <p class="lead">Manage patients, doctors, staff, and every hospital operation from one place — fast, secure, and simple.</p>
    <a asp-controller="Users" asp-action="Index" class="btn btn-hero">
        <i class="bi bi-speedometer2 me-1"></i> Get Started
    </a>
</div>

<div class="row g-4">
    <div class="col-md-6 col-lg-3">
        <div class="feature-card">
            <div class="feature-icon bg-teal">
                <i class="bi bi-people-fill"></i>
            </div>
            <h5>User Management</h5>
            <p>Create, edit, and control every user account from one place.</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="feature-card">
            <div class="feature-icon bg-blue">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h5>Role & Access</h5>
            <p>Set permissions by role — Admin, Doctor, Receptionist, and more.</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="feature-card">
            <div class="feature-icon bg-purple">
                <i class="bi bi-person-badge-fill"></i>
            </div>
            <h5>Doctors & Staff</h5>
            <p>Manage information for doctors, lab technicians, and pharmacists.</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="feature-card">
            <div class="feature-icon bg-amber">
                <i class="bi bi-clipboard2-pulse-fill"></i>
            </div>
            <h5>Patient Records</h5>
            <p>Securely store and view patient details and treatment history.</p>
        </div>
    </div>
</div>