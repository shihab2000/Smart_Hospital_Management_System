@model SHMS.Models.Admission

@{
    ViewData["Title"] = "Delete";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-3 text-white bg-danger"
                         style="width:48px;height:48px;">
                        <i class="bi bi-exclamation-triangle fs-5"></i>
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold">Delete Admission</h1>
                        <p class="text-muted small mb-0">This action cannot be undone.</p>
                    </div>
                </div>

                <div class="alert alert-danger d-flex align-items-center gap-2 py-2 small mb-4">
                    <i class="bi bi-info-circle"></i>
                    Are you sure you want to permanently delete this admission record?
                </div>

                <hr class="mb-4" />

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-normal">Patient</dt>
                    <dd class="col-sm-8">@(Model?.Patient?.Name ?? "—")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">Ward</dt>
                    <dd class="col-sm-8">@(Model?.Ward?.WardName ?? "—")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">Bed</dt>
                    <dd class="col-sm-8">@(Model?.Bed?.BedNumber ?? "—")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">Admission Date</dt>
                    <dd class="col-sm-8">@Model?.AdmissionDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge rounded-pill @(Model?.Status == "Admitted" ? "text-bg-primary" : "text-bg-secondary")">
                            @Model?.Status
                        </span>
                    </dd>
                </dl>

                <hr class="my-4" />

                <form asp-action="Delete">
                    <input type="hidden" asp-for="AdmissionId" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger flex-fill fw-semibold">
                            <i class="bi bi-trash me-1"></i> Delete
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>