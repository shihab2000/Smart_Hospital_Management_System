@model IEnumerable<SHMS.Models.Admission>

@{
    ViewData["Title"] = "Admissions";
    var activeOnly = ViewData["ActiveOnly"] as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Admissions</h1>
        <p class="text-muted small mb-0">Manage patient admissions and discharges.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold">
        <i class="bi bi-plus-lg me-1"></i> Admit Patient
    </a>
</div>

<div class="d-flex gap-2 mb-3">
    <a asp-action="Index" asp-route-activeOnly="false"
       class="btn btn-sm @(activeOnly ? "btn-outline-secondary" : "btn-secondary")">
        All Admissions
    </a>
    <a asp-action="Index" asp-route-activeOnly="true"
       class="btn btn-sm @(activeOnly ? "btn-primary" : "btn-outline-primary")">
        <i class="bi bi-hospital me-1"></i> Currently Admitted
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Patient</th>
                    <th>Ward</th>
                    <th>Bed</th>
                    <th>Admission Date</th>
                    <th>Discharge Date</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="ps-4 fw-semibold">@(item.Patient?.Name ?? "—")</td>
                    <td class="text-muted">@(item.Ward?.WardName ?? "—")</td>
                    <td class="text-muted">@(item.Bed?.BedNumber ?? "—")</td>
                    <td>@item.AdmissionDate.ToString("dd MMM yyyy")</td>
                    <td class="text-muted">@(item.DischargeDate?.ToString("dd MMM yyyy") ?? "—")</td>
                    <td>
                        <span class="badge rounded-pill @(item.Status == "Admitted" ? "text-bg-primary" : "text-bg-secondary")">
                            @item.Status
                        </span>
                    </td>
                    <td class="text-end pe-4">
                        <a asp-action="Details" asp-route-id="@item.AdmissionId" class="btn btn-sm btn-outline-secondary border-0" title="Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        @if (item.Status == "Admitted")
                        {
                            <form asp-action="Discharge" asp-route-id="@item.AdmissionId" method="post" class="d-inline"
                                  onsubmit="return confirm('Discharge this patient?');">
                                <button type="submit" class="btn btn-sm btn-outline-success border-0" title="Discharge">
                                    <i class="bi bi-box-arrow-right"></i>
                                </button>
                            </form>
                        }
                        <a asp-action="Delete" asp-route-id="@item.AdmissionId" class="btn btn-sm btn-outline-danger border-0" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-clipboard2-check display-6 d-block mb-2"></i>
        @(activeOnly ? "No patients currently admitted." : "No admissions found.")
    </div>
}

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }

    .table > :not(caption) > * > * {
        padding-top: .9rem;
        padding-bottom: .9rem;
    }
</style>