@model SHMS.Models.Admission

@{
    ViewData["Title"] = "Admit Patient";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-3 text-white"
                         style="width:48px;height:48px;background:linear-gradient(135deg, var(--brand-secondary), var(--brand-primary));">
                        <i class="bi bi-clipboard2-plus fs-5"></i>
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold">Admit Patient</h1>
                        <p class="text-muted small mb-0">Assign a patient to a ward and bed.</p>
                    </div>
                </div>

                <hr class="mb-4" />

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="PatientId" class="form-select" asp-items="ViewBag.PatientId">
                                    <option value="">-- Select Patient --</option>
                                </select>
                                <label asp-for="PatientId"></label>
                                <span asp-validation-for="PatientId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="AdmissionDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                <label asp-for="AdmissionDate"></label>
                                <span asp-validation-for="AdmissionDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="WardId" class="form-select" asp-items="ViewBag.WardId" id="wardSelect">
                                    <option value="">-- Select Ward --</option>
                                </select>
                                <label asp-for="WardId"></label>
                                <span asp-validation-for="WardId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="BedId" class="form-select" id="bedSelect">
                                    <option value="">-- Select Ward First --</option>
                                </select>
                                <label asp-for="BedId"></label>
                                <span asp-validation-for="BedId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary flex-fill py-2 fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Admit Patient
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-2">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    </div>
                </form>

            </div>
        </div>

        <div class="text-center mt-3">
            <a asp-action="Index" class="text-decoration-none small">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 .2rem rgba(13, 148, 136, .15);
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.getElementById('wardSelect').addEventListener('change', async function () {
            const wardId = this.value;
            const bedSelect = document.getElementById('bedSelect');
            bedSelect.innerHTML = '<option value="">Loading...</option>';

            if (!wardId) {
                bedSelect.innerHTML = '<option value="">-- Select Ward First --</option>';
                return;
            }

            try {
                const response = await fetch(`@Url.Action("GetAvailableBeds", "Admissions")?wardId=${wardId}`);
                const beds = await response.json();

                if (beds.length === 0) {
                    bedSelect.innerHTML = '<option value="">No available beds in this ward</option>';
                    return;
                }

                bedSelect.innerHTML = '<option value="">-- Select Bed --</option>';
                beds.forEach(bed => {
                    const option = document.createElement('option');
                    option.value = bed.bedId;
                    option.text = bed.bedNumber;
                    bedSelect.appendChild(option);
                });
            } catch (err) {
                bedSelect.innerHTML = '<option value="">Failed to load beds</option>';
            }
        });
    </script>
}