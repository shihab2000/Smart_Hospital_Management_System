@model SHMS.Models.User

@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        @if (TempData["ProfileUpdated"] != null)
        {
            <div class="alert alert-success py-2 small">@TempData["ProfileUpdated"]</div>
        }

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-circle text-white fw-bold fs-4"
                         style="width:64px;height:64px;background:linear-gradient(135deg, var(--brand-secondary), var(--brand-primary));">
                        @(Model.Name.Length > 0 ? Model.Name.Substring(0, 1).ToUpper() : "?")
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold">@Model.Name</h1>
                        <p class="text-muted small mb-0">@(Model.Role?.RoleName ?? "—")</p>
                    </div>
                </div>

                <hr class="mb-4" />

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-envelope me-2"></i>Email
                    </dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-telephone me-2"></i>Phone
                    </dt>
                    <dd class="col-sm-8">@(Model.Phone ?? "—")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-circle-fill me-2" style="font-size:.6rem;"></i>Status
                    </dt>
                    <dd class="col-sm-8">
                        <span class="badge rounded-pill @(Model.Status == "Active" ? "text-bg-success" : "text-bg-secondary")">
                            @Model.Status
                        </span>
                    </dd>
                </dl>

                <hr class="my-4" />

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="Edit" class="btn btn-primary fw-semibold">
                        <i class="bi bi-pencil me-1"></i> Edit Profile
                    </a>
                    <a asp-action="ChangePassword" class="btn btn-outline-secondary">
                        <i class="bi bi-key me-1"></i> Change Password
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }
</style>