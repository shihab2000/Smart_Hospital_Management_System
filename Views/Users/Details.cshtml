@model SHMS.Models.User

@{
    ViewData["Title"] = "Details";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-circle text-white fw-bold fs-4"
                         style="width:64px;height:64px;background:linear-gradient(135deg, var(--brand-secondary), var(--brand-primary));">
                        @(Model?.Name?.Length > 0 ? Model.Name.Substring(0, 1).ToUpper() : "?")
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold">@Html.DisplayFor(model => model.Name)</h1>
                        <p class="text-muted small mb-0">@(Model?.Role?.RoleName ?? "No role assigned")</p>
                    </div>
                </div>

                <hr class="mb-4" />

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-envelope me-2"></i>@Html.DisplayNameFor(model => model.Email)
                    </dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-telephone me-2"></i>@Html.DisplayNameFor(model => model.Phone)
                    </dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Phone)</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-shield-check me-2"></i>@Html.DisplayNameFor(model => model.Role)
                    </dt>
                    <dd class="col-sm-8">@(Model?.Role?.RoleName ?? "No role assigned")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-circle-fill me-2" style="font-size:.6rem;"></i>@Html.DisplayNameFor(model => model.Status)
                    </dt>
                    <dd class="col-sm-8">
                        @{
                            var isActive = Model?.Status?.ToString().ToLower() == "active";
                        }
                        <span class="badge rounded-pill @(isActive ? "text-bg-success" : "text-bg-secondary")">
                            @(Model?.Status ?? "—")
                        </span>
                    </dd>
                </dl>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.UserId" class="btn btn-primary flex-fill fw-semibold">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }
</style>