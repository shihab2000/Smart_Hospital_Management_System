@model IEnumerable<SHMS.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
    var todayOnly = ViewData["TodayOnly"] as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Appointments</h1>
        <p class="text-muted small mb-0">View and manage all patient appointments.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold">
        <i class="bi bi-plus-lg me-1"></i> Create New
    </a>
</div>

<div class="d-flex gap-2 mb-3">
    <a asp-action="Index" asp-route-today="false"
       class="btn btn-sm @(todayOnly ? "btn-outline-secondary" : "btn-secondary")">
        All Appointments
    </a>
    <a asp-action="Index" asp-route-today="true"
       class="btn btn-sm @(todayOnly ? "btn-secondary" : "btn-outline-secondary")">
        <i class="bi bi-calendar-day me-1"></i> Today's Appointments
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">@Html.DisplayNameFor(model => model.Patient)</th>
                    <th>@Html.DisplayNameFor(model => model.Doctor)</th>
                    <th>@Html.DisplayNameFor(model => model.AppointmentDate)</th>
                    <th>@Html.DisplayNameFor(model => model.AppointmentTime)</th>
                    <th>@Html.DisplayNameFor(model => model.Reason)</th>
                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="ps-4 fw-semibold">@(item.Patient?.Name ?? "—")</td>
                    <td class="text-muted">@(item.Doctor?.Name ?? "—")</td>
                    <td>@item.AppointmentDate.ToString("dd MMM yyyy")</td>
                    <td class="text-muted">@item.AppointmentTime.ToString(@"hh\:mm")</td>
                    <td class="text-muted">@Html.DisplayFor(modelItem => item.Reason)</td>
                    <td>
                        @{
                            var statusClass = item.Status?.ToLower() switch
                            {
                                "confirmed" => "text-bg-success",
                                "completed" => "text-bg-primary",
                                "cancelled" => "text-bg-danger",
                                "pending" => "text-bg-warning",
                                _ => "text-bg-secondary"
                            };
                        }
                        <span class="badge rounded-pill @statusClass">
                            @Html.DisplayFor(modelItem => item.Status)
                        </span>
                    </td>
                    <td class="text-end pe-4">
                        <a asp-action="Details" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-outline-secondary border-0" title="Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-outline-primary border-0" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        @if (item.Status?.ToLower() != "cancelled" && item.Status?.ToLower() != "completed")
                        {
                            <a asp-action="Reschedule" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-outline-warning border-0" title="Reschedule">
                                <i class="bi bi-calendar-event"></i>
                            </a>
                            <form asp-action="Cancel" asp-route-id="@item.AppointmentId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Cancel">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </form>
                        }
                        <a asp-action="Delete" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-outline-danger border-0" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-calendar-check display-6 d-block mb-2"></i>
        @(todayOnly ? "No appointments today." : "No appointments found.")
    </div>
}

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }

    .table > :not(caption) > * > * {
        padding-top: .9rem;
        padding-bottom: .9rem;
    }
</style>