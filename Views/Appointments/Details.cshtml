@model SHMS.Models.Appointment

@{
    ViewData["Title"] = "Details";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-3 text-white fs-4"
                         style="width:64px;height:64px;background:linear-gradient(135deg, var(--brand-secondary), var(--brand-primary));">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold">Appointment Details</h1>
                        <p class="text-muted small mb-0">
                            @(Model?.AppointmentDate.ToString("dd MMM yyyy")) at @(Model?.AppointmentTime.ToString(@"hh\:mm"))
                        </p>
                    </div>
                </div>

                <hr class="mb-4" />

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-person me-2"></i>@Html.DisplayNameFor(model => model.Patient)
                    </dt>
                    <dd class="col-sm-8">@(Model?.Patient?.Name ?? "—")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-person-badge me-2"></i>@Html.DisplayNameFor(model => model.Doctor)
                    </dt>
                    <dd class="col-sm-8">@(Model?.Doctor?.Name ?? "—")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-calendar3 me-2"></i>@Html.DisplayNameFor(model => model.AppointmentDate)
                    </dt>
                    <dd class="col-sm-8">@Model?.AppointmentDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-clock me-2"></i>@Html.DisplayNameFor(model => model.AppointmentTime)
                    </dt>
                    <dd class="col-sm-8">@Model?.AppointmentTime.ToString(@"hh\:mm")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-card-text me-2"></i>@Html.DisplayNameFor(model => model.Reason)
                    </dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Reason)</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-circle-fill me-2" style="font-size:.6rem;"></i>@Html.DisplayNameFor(model => model.Status)
                    </dt>
                    <dd class="col-sm-8">
                        @{
                            var statusClass = Model?.Status?.ToLower() switch
                            {
                                "confirmed" => "text-bg-success",
                                "completed" => "text-bg-primary",
                                "cancelled" => "text-bg-danger",
                                "pending" => "text-bg-warning",
                                _ => "text-bg-secondary"
                            };
                        }
                        <span class="badge rounded-pill @statusClass">
                            @Html.DisplayFor(model => model.Status)
                        </span>
                    </dd>
                </dl>

                <hr class="my-4" />

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="Edit" asp-route-id="@Model?.AppointmentId" class="btn btn-primary fw-semibold">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    @if (Model?.Status?.ToLower() != "cancelled" && Model?.Status?.ToLower() != "completed")
                    {
                        <a asp-action="Reschedule" asp-route-id="@Model?.AppointmentId" class="btn btn-outline-warning fw-semibold">
                            <i class="bi bi-calendar-event me-1"></i> Reschedule
                        </a>
                        <form asp-action="Cancel" asp-route-id="@Model?.AppointmentId" method="post" class="d-inline"
                              onsubmit="return confirm('Cancel this appointment?');">
                            <button type="submit" class="btn btn-outline-danger fw-semibold">
                                <i class="bi bi-x-circle me-1"></i> Cancel
                            </button>
                        </form>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }
</style>