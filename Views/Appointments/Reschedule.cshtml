@model SHMS.Models.Appointment

@{
    ViewData["Title"] = "Reschedule Appointment";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-3 text-white"
                         style="width:48px;height:48px;background:linear-gradient(135deg, var(--brand-secondary), var(--brand-primary));">
                        <i class="bi bi-calendar-event fs-5"></i>
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold">Reschedule Appointment</h1>
                        <p class="text-muted small mb-0">
                            @(Model?.Patient?.Name ?? "—") with @(Model?.Doctor?.Name ?? "—")
                        </p>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="alert alert-light border small mb-4">
                    <i class="bi bi-info-circle me-1"></i>
                    Current: @Model?.AppointmentDate.ToString("dd MMM yyyy") at @Model?.AppointmentTime.ToString(@"hh\:mm")
                    — rescheduling will reset status to <strong>Pending</strong>.
                </div>

                <form asp-action="Reschedule" asp-route-id="@Model?.AppointmentId" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="date" name="appointmentDate" class="form-control"
                                       value="@Model?.AppointmentDate.ToString("yyyy-MM-dd")" required />
                                <label>New Date</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input type="time" name="appointmentTime" class="form-control"
                                       value="@Model?.AppointmentTime.ToString(@"hh\:mm")" required />
                                <label>New Time</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary flex-fill py-2 fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Confirm Reschedule
                        </button>
                        <a asp-action="Details" asp-route-id="@Model?.AppointmentId" class="btn btn-outline-secondary py-2">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }
</style>