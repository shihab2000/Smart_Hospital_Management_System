<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SHMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SHMS.styles.css" asp-append-version="true" />
    <style>
        :root {
            --brand-primary: #0d9488;
            --brand-secondary: #0369a1;
            --brand-dark: #0f172a;
            --sidebar-width: 250px;
        }

        html, body { min-height: 100%; }
        html { overflow-y: scroll; }

        body {
            font-family: 'Poppins', 'Segoe UI', sans-serif;
            background: #f8fafc;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            height: auto;
        }
        /* ===== Topbar ===== */
        .topbar {
            background: linear-gradient(90deg, var(--brand-secondary) 0%, var(--brand-primary) 100%);
            box-shadow: 0 2px 12px rgba(3, 105, 161, 0.25);
            padding: .6rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1050;
        }

        .topbar-brand {
            font-weight: 700;
            font-size: 1.3rem;
            color: #fff;
            display: flex;
            align-items: center;
            gap: .5rem;
            text-decoration: none;
            background: none;
            border: none;
            cursor: pointer;
        }

        .sidebar-toggle {
            background: rgba(255,255,255,0.15);
            border: none;
            color: #fff;
            width: 38px;
            height: 38px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .topbar-user .dropdown-toggle {
            color: #fff;
            background: rgba(255,255,255,0.15);
            border: none;
            border-radius: 8px;
            padding: .4rem .9rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: .4rem;
        }

        .topbar-user .dropdown-toggle::after { display: none; }

        .topbar-login-btn {
            background: #fff;
            color: var(--brand-secondary);
            font-weight: 600;
            border-radius: 8px;
            padding: .45rem 1.1rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: .4rem;
        }

        /* ===== Layout shell ===== */
        .app-shell {
            display: flex;
            flex: 1;
            min-height: 0;
            position: relative;
        }

        /* ===== Sidebar — closed by default on ALL screen sizes ===== */
        .sidebar {
            width: var(--sidebar-width);
            flex-shrink: 0;
            background: #fff;
            border-right: 1px solid #e2e8f0;
            overflow-y: auto;
            overflow-x: hidden;
            height: calc(100vh - 58px);
            position: fixed;
            top: 58px;
            left: calc(-1 * var(--sidebar-width));
            z-index: 1040;
            transition: left .25s ease;
            box-shadow: 4px 0 20px rgba(0,0,0,0.12);
            padding: 1rem 0;
        }

        .sidebar.show {
            left: 0;
        }

        .sidebar-backdrop {
            display: none;
            position: fixed;
            inset: 58px 0 0 0;
            background: rgba(0,0,0,0.35);
            z-index: 1035;
        }

        .sidebar-backdrop.show {
            display: block;
        }

        .sidebar-section-title {
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #94a3b8;
            font-weight: 600;
            padding: .9rem 1.1rem .35rem;
        }

        .sidebar .nav-link {
            color: #334155;
            font-weight: 500;
            font-size: .92rem;
            padding: .55rem 1.1rem;
            display: flex;
            align-items: center;
            gap: .65rem;
            border-radius: 0;
        }

        .sidebar .nav-link i {
            font-size: 1.05rem;
            width: 20px;
            text-align: center;
            color: #64748b;
        }

        .sidebar .nav-link:hover {
            background: #f1f5f9;
            color: var(--brand-primary);
        }

        .sidebar .nav-link:hover i {
            color: var(--brand-primary);
        }

        /* ===== Main content — always full width, sidebar overlays ===== */
        .main-content {
            flex: 1;
            min-width: 0;
            padding: 1.75rem;
            width: 100%;
        }

        /* ===== Footer ===== */
        .footer-shms {
            background: var(--brand-dark);
            color: rgba(255, 255, 255, 0.7);
            padding: 1rem 0;
            font-size: .85rem;
        }

        .footer-shms a {
            color: rgba(255, 255, 255, 0.9);
            text-decoration: none;
        }

        @@media (max-width: 575.98px) {
            .main-content { padding: 1.1rem; }
        }
    </style>
</head>
<body>

    <header class="topbar">
        <div class="d-flex align-items-center gap-2">
            <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="Toggle menu">
                <i class="bi bi-list"></i>
            </button>
            <button class="topbar-brand" id="brandToggle" type="button">
                <i class="bi bi-hospital"></i> SHMS
            </button>
        </div>

        <div class="topbar-user">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="dropdown">
                    <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle"></i>
                        <span class="d-none d-sm-inline">@User.Identity.Name</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><span class="dropdown-item-text small text-muted">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>My Profile</a></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a class="topbar-login-btn" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right"></i> Login
                </a>
            }
        </div>
    </header>

    <div class="app-shell">

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <nav class="sidebar" id="sidebar">

            <a class="nav-link" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door"></i> Home
            </a>

            @if (User.IsInRole("Super Admin") || User.IsInRole("Hospital Admin"))
            {
                <div class="sidebar-section-title">Overview</div>
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                <a class="nav-link" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-fill"></i> Reports</a>
            }

            @if (User.IsInRole("Super Admin"))
            {
                <div class="sidebar-section-title">Administration</div>
                <a class="nav-link" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> Users</a>
                <a class="nav-link" asp-controller="Roles" asp-action="Index"><i class="bi bi-shield-lock"></i> Roles</a>
            }

            @if (User.IsInRole("Super Admin") || User.IsInRole("Hospital Admin") || User.IsInRole("Receptionist") || User.IsInRole("Doctor"))
            {
                <div class="sidebar-section-title">Hospital</div>
                <a class="nav-link" asp-controller="Departments" asp-action="Index"><i class="bi bi-diagram-3"></i> Departments</a>
                <a class="nav-link" asp-controller="Doctors" asp-action="Index"><i class="bi bi-person-badge"></i> Doctors</a>
                <a class="nav-link" asp-controller="Patients" asp-action="Index"><i class="bi bi-heart-pulse"></i> Patients</a>
                <a class="nav-link" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar-check"></i> Appointments</a>
            }

            @if (User.IsInRole("Super Admin") || User.IsInRole("Hospital Admin") || User.IsInRole("Doctor"))
            {
                <div class="sidebar-section-title">Records</div>
                <a class="nav-link" asp-controller="MedicalRecords" asp-action="Index"><i class="bi bi-file-medical"></i> Medical Records</a>
                <a class="nav-link" asp-controller="Prescriptions" asp-action="Index"><i class="bi bi-prescription2"></i> Prescriptions</a>
                <a class="nav-link" asp-controller="PrescriptionItems" asp-action="Index"><i class="bi bi-capsule"></i> Prescription Items</a>
            }

            @if (User.IsInRole("Super Admin") || User.IsInRole("Hospital Admin") || User.IsInRole("Pharmacist"))
            {
                <div class="sidebar-section-title">Pharmacy</div>
                <a class="nav-link" asp-controller="Medicines" asp-action="Index"><i class="bi bi-capsule"></i> Medicines</a>
                <a class="nav-link" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck"></i> Suppliers</a>
                <a class="nav-link" asp-controller="Purchases" asp-action="Index"><i class="bi bi-cart-check"></i> Purchases</a>
                <a class="nav-link" asp-controller="Sales" asp-action="Index"><i class="bi bi-cash-coin"></i> Sales</a>
            }

            @if (User.IsInRole("Super Admin") || User.IsInRole("Hospital Admin") || User.IsInRole("Laboratory Technician"))
            {
                <div class="sidebar-section-title">Laboratory</div>
                <a class="nav-link" asp-controller="LabTests" asp-action="Index"><i class="bi bi-clipboard-pulse"></i> Lab Tests</a>
                <a class="nav-link" asp-controller="LabReports" asp-action="Index"><i class="bi bi-file-earmark-medical"></i> Lab Reports</a>
            }

            @if (User.IsInRole("Super Admin") || User.IsInRole("Hospital Admin") || User.IsInRole("Receptionist") || User.IsInRole("Accountant"))
            {
                <div class="sidebar-section-title">Billing</div>
                <a class="nav-link" asp-controller="Invoices" asp-action="Index"><i class="bi bi-receipt"></i> Invoices</a>
                <a class="nav-link" asp-controller="Payments" asp-action="Index"><i class="bi bi-credit-card"></i> Payments</a>
            }

            @if (User.IsInRole("Super Admin") || User.IsInRole("Hospital Admin"))
            {
                <a class="nav-link" asp-controller="InventoryItems" asp-action="Index"><i class="bi bi-box-seam"></i> Inventory</a>
            }

            @if (User.IsInRole("Super Admin") || User.IsInRole("Hospital Admin") || User.IsInRole("Receptionist"))
            {
                <div class="sidebar-section-title">Admission</div>
                <a class="nav-link" asp-controller="Wards" asp-action="Index"><i class="bi bi-building"></i> Wards</a>
                <a class="nav-link" asp-controller="Beds" asp-action="Index"><i class="bi bi-file-earmark-ruled"></i> Beds</a>
                <a class="nav-link" asp-controller="Admissions" asp-action="Index"><i class="bi bi-clipboard2-check"></i> Admissions</a>
            }

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="sidebar-section-title">Account</div>
                <a class="nav-link" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle"></i> My Profile</a>
            }

        </nav>

        <main class="main-content">
            @RenderBody()
        </main>

    </div>

    <footer class="footer-shms border-top">
        <div class="container-fluid px-4 d-flex flex-wrap justify-content-between align-items-center">
            <span>&copy; 2026 - <strong>SHMS</strong> - Smart Hospital Management System</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const sidebar = document.getElementById('sidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        const toggleBtn = document.getElementById('sidebarToggle');
        const brandBtn = document.getElementById('brandToggle');

        function openSidebar() {
            sidebar.classList.add('show');
            backdrop.classList.add('show');
        }

        function closeSidebar() {
            sidebar.classList.remove('show');
            backdrop.classList.remove('show');
        }

        function toggleSidebar() {
            sidebar.classList.contains('show') ? closeSidebar() : openSidebar();
        }

        toggleBtn?.addEventListener('click', toggleSidebar);
        brandBtn?.addEventListener('click', toggleSidebar);
        backdrop?.addEventListener('click', closeSidebar);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>