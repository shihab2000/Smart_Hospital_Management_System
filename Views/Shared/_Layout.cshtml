<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SHMS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SHMS.styles.css" asp-append-version="true" />
    <style>
        :root {
            --brand-primary: #0d9488;
            --brand-secondary: #0369a1;
            --brand-accent: #14b8a6;
            --brand-dark: #0f172a;
            --surface: #f8fafc;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'Poppins', 'Segoe UI', sans-serif;
            background: var(--surface);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ===== Navbar ===== */
        .navbar-shms {
            background: linear-gradient(90deg, var(--brand-secondary) 0%, var(--brand-primary) 100%);
            box-shadow: 0 2px 12px rgba(3, 105, 161, 0.25);
            padding-top: .6rem;
            padding-bottom: .6rem;
        }

        .navbar-shms .navbar-brand {
            font-weight: 700;
            font-size: 1.3rem;
            color: #fff !important;
            display: flex;
            align-items: center;
            gap: .5rem;
            letter-spacing: .5px;
        }

        .navbar-shms .navbar-brand i {
            font-size: 1.5rem;
        }

        .navbar-shms .nav-link,
        .navbar-shms .dropdown-toggle {
            color: rgba(255, 255, 255, 0.88) !important;
            font-weight: 500;
            font-size: .92rem;
            padding: .45rem .75rem !important;
            border-radius: 8px;
            transition: all .2s ease;
            display: flex;
            align-items: center;
            gap: .35rem;
            white-space: nowrap;
        }

        .navbar-shms .nav-link:hover,
        .navbar-shms .nav-link.active,
        .navbar-shms .dropdown-toggle:hover,
        .navbar-shms .dropdown-toggle:focus,
        .navbar-shms .dropdown.show .dropdown-toggle {
            color: #fff !important;
            background: rgba(255, 255, 255, 0.15);
        }

        .navbar-shms .dropdown-toggle::after {
            margin-left: .3rem;
            vertical-align: .1rem;
        }

        .navbar-shms .dropdown-menu {
            border: none;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.15);
            padding: .5rem;
            margin-top: .5rem;
        }

        .navbar-shms .dropdown-item {
            border-radius: 8px;
            padding: .5rem .75rem;
            font-size: .9rem;
            display: flex;
            align-items: center;
            gap: .5rem;
            color: #334155;
        }

        .navbar-shms .dropdown-item:hover,
        .navbar-shms .dropdown-item:focus {
            background: rgba(13, 148, 136, 0.1);
            color: var(--brand-primary);
        }

        .navbar-shms .dropdown-item.active {
            background: var(--brand-primary);
            color: #fff;
        }

        .navbar-shms .navbar-toggler {
            border: none;
            filter: brightness(0) invert(1);
        }

        /* ===== Main content ===== */
        main.pb-3 {
            flex: 1;
        }

        .container {
            max-width: 1200px;
        }

        .page-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
            padding: 2rem;
        }

        /* ===== Footer ===== */
        .footer-shms {
            background: var(--brand-dark);
            color: rgba(255, 255, 255, 0.7);
            padding: 1.2rem 0;
            font-size: .9rem;
        }

        .footer-shms a {
            color: rgba(255, 255, 255, 0.9);
            text-decoration: none;
        }

        .footer-shms a:hover {
            color: #fff;
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-sm navbar-shms mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-hospital"></i>
                    SHMS
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between" id="navbarSupportedContent">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-people"></i> Admin
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> Users</a></li>
                                <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index"><i class="bi bi-shield-lock"></i> Roles</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-hospital"></i> Hospital
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Departments" asp-action="Index"><i class="bi bi-diagram-3"></i> Departments</a></li>
                                <li><a class="dropdown-item" asp-controller="Doctors" asp-action="Index"><i class="bi bi-person-badge"></i> Doctors</a></li>
                                <li><a class="dropdown-item" asp-controller="Patients" asp-action="Index"><i class="bi bi-heart-pulse"></i> Patients</a></li>
                                <li><a class="dropdown-item" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar-check"></i> Appointments</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-file-medical"></i> Records
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="MedicalRecords" asp-action="Index"><i class="bi bi-file-medical"></i> Medical Records</a></li>
                                <li><a class="dropdown-item" asp-controller="Prescriptions" asp-action="Index"><i class="bi bi-prescription2"></i> Prescriptions</a></li>
                                <li><a class="dropdown-item" asp-controller="PrescriptionItems" asp-action="Index"><i class="bi bi-capsule"></i> Prescription Items</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-capsule-pill"></i> Pharmacy
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Medicines" asp-action="Index"><i class="bi bi-capsule"></i> Medicines</a></li>
                                <li><a class="dropdown-item" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck"></i> Suppliers</a></li>
                                <li><a class="dropdown-item" asp-controller="Purchases" asp-action="Index"><i class="bi bi-cart-check"></i> Purchases</a></li>
                                <li><a class="dropdown-item" asp-controller="Sales" asp-action="Index"><i class="bi bi-cash-coin"></i> Sales</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-clipboard-pulse"></i> Lab
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="LabTests" asp-action="Index"><i class="bi bi-clipboard-pulse"></i> Lab Tests</a></li>
                                <li><a class="dropdown-item" asp-controller="LabReports" asp-action="Index"><i class="bi bi-file-earmark-medical"></i> Lab Reports</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-receipt"></i> Billing
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Invoices" asp-action="Index"><i class="bi bi-receipt"></i> Invoices</a></li>
                                <li><a class="dropdown-item" asp-controller="Payments" asp-action="Index"><i class="bi bi-credit-card"></i> Payments</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="InventoryItems" asp-action="Index">
                                <i class="bi bi-box-seam"></i> Inventory
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-hospital"></i> Admission
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Wards" asp-action="Index"><i class="bi bi-building"></i> Wards</a></li>
                                <li><a class="dropdown-item" asp-controller="Beds" asp-action="Index"><i class="bi bi-file-earmark-ruled"></i> Beds</a></li>
                                <li><a class="dropdown-item" asp-controller="Admissions" asp-action="Index"><i class="bi bi-clipboard2-check"></i> Admissions</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-shms border-top mt-auto">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <span>&copy; 2026 - <strong>SHMS</strong> - Smart Hospital Management System</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>