<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SHMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SHMS.styles.css" asp-append-version="true" />
    <style>
        :root {
            --brand-primary: #0d9488;
            --brand-secondary: #0369a1;
            --brand-dark: #0f172a;
        }

        html, body { height: 100%; }

        body {
            font-family: 'Poppins', 'Segoe UI', sans-serif;
            background: #f8fafc;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .topbar {
            background: linear-gradient(90deg, var(--brand-secondary) 0%, var(--brand-primary) 100%);
            box-shadow: 0 2px 12px rgba(3, 105, 161, 0.25);
            padding: .6rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1050;
        }

        .topbar-brand {
            font-weight: 700;
            font-size: 1.3rem;
            color: #fff;
            display: flex;
            align-items: center;
            gap: .5rem;
            text-decoration: none;
        }

        .topbar-user .dropdown-toggle {
            color: #fff;
            background: rgba(255,255,255,0.15);
            border: none;
            border-radius: 8px;
            padding: .4rem .9rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: .4rem;
        }

        .topbar-user .dropdown-toggle::after { display: none; }

        .topbar-login-btn {
            background: #fff;
            color: var(--brand-secondary);
            font-weight: 600;
            border-radius: 8px;
            padding: .45rem 1.1rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: .4rem;
        }

        .main-content {
            flex: 1;
            padding: 1.75rem;
        }

        .footer-shms {
            background: var(--brand-dark);
            color: rgba(255, 255, 255, 0.7);
            padding: 1rem 0;
            font-size: .85rem;
        }

        .footer-shms a {
            color: rgba(255, 255, 255, 0.9);
            text-decoration: none;
        }

        @@media (max-width: 575.98px) {
            .main-content { padding: 1.1rem; }
        }
    </style>
</head>
<body>

    <header class="topbar">
        <a class="topbar-brand" asp-controller="Home" asp-action="Index">
            <i class="bi bi-hospital"></i> SHMS
        </a>

        <div class="topbar-user">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="dropdown">
                    <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle"></i>
                        <span class="d-none d-sm-inline">@User.Identity.Name</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>My Profile</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a class="topbar-login-btn" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right"></i> Login
                </a>
            }
        </div>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer-shms border-top">
        <div class="container-fluid px-4 d-flex flex-wrap justify-content-between align-items-center">
            <span>&copy; 2026 - <strong>SHMS</strong> - Smart Hospital Management System</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>