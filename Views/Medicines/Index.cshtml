@model IEnumerable<SHMS.Models.Medicine>

@{
    ViewData["Title"] = "Medicines";
    var currentFilter = ViewData["CurrentFilter"] as string;
    var lowStockThreshold = (int)ViewData["LowStockThreshold"]!;
    var expiryWarningDate = (DateTime)ViewData["ExpiryWarningDate"]!;
    var today = DateTime.UtcNow.Date;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Medicines</h1>
        <p class="text-muted small mb-0">Manage medicine stock and suppliers.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold">
        <i class="bi bi-plus-lg me-1"></i> Create New
    </a>
</div>

<div class="d-flex gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(currentFilter) ? "btn-secondary" : "btn-outline-secondary")">
        All Medicines
    </a>
    <a asp-action="Index" asp-route-filter="lowstock"
       class="btn btn-sm @(currentFilter == "lowstock" ? "btn-warning" : "btn-outline-warning")">
        <i class="bi bi-exclamation-triangle me-1"></i> Low Stock
    </a>
    <a asp-action="Index" asp-route-filter="expiring"
       class="btn btn-sm @(currentFilter == "expiring" ? "btn-danger" : "btn-outline-danger")">
        <i class="bi bi-calendar-x me-1"></i> Expiring Soon
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">@Html.DisplayNameFor(model => model.MedicineName)</th>
                    <th>@Html.DisplayNameFor(model => model.Supplier)</th>
                    <th>@Html.DisplayNameFor(model => model.Quantity)</th>
                    <th>@Html.DisplayNameFor(model => model.UnitPrice)</th>
                    <th>@Html.DisplayNameFor(model => model.ExpiryDate)</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td class="ps-4 fw-semibold">@Html.DisplayFor(modelItem => item.MedicineName)</td>
                    <td class="text-muted">@(item.Supplier?.SupplierName ?? "—")</td>
                    <td>
                        <span class="badge rounded-pill @(item.Quantity < lowStockThreshold ? "text-bg-warning" : "text-bg-light border")">
                            @item.Quantity
                            @if (item.Quantity < lowStockThreshold)
                            {
                                <i class="bi bi-exclamation-triangle-fill ms-1"></i>
                            }
                        </span>
                    </td>
                    <td class="text-muted">৳@item.UnitPrice.ToString("0.00")</td>
                    <td>
                        @{
                            var expiryClass = item.ExpiryDate.Date < today ? "text-bg-danger"
                                : item.ExpiryDate.Date <= expiryWarningDate ? "text-bg-warning"
                                : "text-bg-light border";
                        }
                        <span class="badge rounded-pill @expiryClass">
                            @item.ExpiryDate.ToString("dd MMM yyyy")
                        </span>
                    </td>
                    <td class="text-end pe-4">
                        <a asp-action="Details" asp-route-id="@item.MedicineId" class="btn btn-sm btn-outline-secondary border-0" title="Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.MedicineId" class="btn btn-sm btn-outline-primary border-0" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.MedicineId" class="btn btn-sm btn-outline-danger border-0" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-capsule display-6 d-block mb-2"></i>
        No medicines found@(currentFilter == "lowstock" ? " with low stock" : currentFilter == "expiring" ? " expiring soon" : "").
    </div>
}

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }

    .table > :not(caption) > * > * {
        padding-top: .9rem;
        padding-bottom: .9rem;
    }
</style>