@model SHMS.Models.Medicine

@{
    ViewData["Title"] = "Create";
    var supplierList = ViewData["SupplierId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-3 text-white"
                         style="width:48px;height:48px;background:linear-gradient(135deg, var(--brand-secondary), var(--brand-primary));">
                        <i class="bi bi-capsule fs-5"></i>
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold">Add Medicine</h1>
                        <p class="text-muted small mb-0">Add a new medicine to the pharmacy stock.</p>
                    </div>
                </div>

                <hr class="mb-4" />

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="MedicineName" class="form-control" placeholder="Medicine name" />
                                <label asp-for="MedicineName"></label>
                                <span asp-validation-for="MedicineName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="SupplierId" class="form-select" asp-items="supplierList">
                                    <option value="">-- Select Supplier --</option>
                                </select>
                                <label asp-for="SupplierId"></label>
                                <span asp-validation-for="SupplierId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Quantity" type="number" class="form-control" placeholder="Quantity" />
                                <label asp-for="Quantity"></label>
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" placeholder="Unit Price" />
                                <label asp-for="UnitPrice"></label>
                                <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="ExpiryDate" type="date" class="form-control" />
                                <label asp-for="ExpiryDate"></label>
                                <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary flex-fill py-2 fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Create
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-2">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    </div>
                </form>

            </div>
        </div>

        <div class="text-center mt-3">
            <a asp-action="Index" class="text-decoration-none small">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 .2rem rgba(13, 148, 136, .15);
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}