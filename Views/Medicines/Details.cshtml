@model SHMS.Models.Medicine

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Medicine</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MedicineName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MedicineName)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MedicineId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>


@{
    ViewData["Title"] = "Details";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-3 text-white fs-4"
                         style="width:64px;height:64px;background:linear-gradient(135deg, var(--brand-secondary), var(--brand-primary));">
                        <i class="bi bi-capsule"></i>
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold">@Html.DisplayFor(model => model.MedicineName)</h1>
                        <p class="text-muted small mb-0">@(Model?.Supplier?.SupplierName ?? "—")</p>
                    </div>
                </div>

                <hr class="mb-4" />

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-truck me-2"></i>@Html.DisplayNameFor(model => model.Supplier)
                    </dt>
                    <dd class="col-sm-8">@(Model?.Supplier?.SupplierName ?? "—")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-boxes me-2"></i>@Html.DisplayNameFor(model => model.Quantity)
                    </dt>
                    <dd class="col-sm-8">@Model?.Quantity</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-tag me-2"></i>@Html.DisplayNameFor(model => model.UnitPrice)
                    </dt>
                    <dd class="col-sm-8">৳@Model?.UnitPrice.ToString("0.00")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-calendar-x me-2"></i>@Html.DisplayNameFor(model => model.ExpiryDate)
                    </dt>
                    <dd class="col-sm-8">@Model?.ExpiryDate.ToString("dd MMM yyyy")</dd>
                </dl>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.MedicineId" class="btn btn-primary flex-fill fw-semibold">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }
</style>