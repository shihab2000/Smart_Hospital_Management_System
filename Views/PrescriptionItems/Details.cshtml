@model SHMS.Models.PrescriptionItem

@{
    ViewData["Title"] = "Details";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-3 text-white fs-4"
                         style="width:64px;height:64px;background:linear-gradient(135deg, var(--brand-secondary), var(--brand-primary));">
                        <i class="bi bi-capsule"></i>
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold">@(Model?.Medicine?.MedicineName ?? "—")</h1>
                        <p class="text-muted small mb-0">
                            @(Model?.Prescription?.Patient?.Name ?? "—") · @(Model?.Prescription?.PrescriptionDate.ToString("dd MMM yyyy") ?? "")
                        </p>
                    </div>
                </div>

                <hr class="mb-4" />

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-prescription2 me-2"></i>@Html.DisplayNameFor(model => model.Prescription)
                    </dt>
                    <dd class="col-sm-8">@(Model?.Prescription?.Patient?.Name ?? "—")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-capsule me-2"></i>@Html.DisplayNameFor(model => model.Medicine)
                    </dt>
                    <dd class="col-sm-8">@(Model?.Medicine?.MedicineName ?? "—")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-eyedropper me-2"></i>@Html.DisplayNameFor(model => model.Dosage)
                    </dt>
                    <dd class="col-sm-8">@Model?.Dosage</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-calendar-week me-2"></i>@Html.DisplayNameFor(model => model.Duration)
                    </dt>
                    <dd class="col-sm-8">@Model?.Duration</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-journal-text me-2"></i>@Html.DisplayNameFor(model => model.Instructions)
                    </dt>
                    <dd class="col-sm-8">@Model?.Instructions</dd>
                </dl>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.PrescriptionItemId" class="btn btn-primary flex-fill fw-semibold">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }
</style>