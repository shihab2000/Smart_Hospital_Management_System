@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="text-center mb-4">
        <div class="auth-icon"><i class="bi bi-key"></i></div>
        <h1 class="h4 fw-bold mt-3 mb-1">Forgot Password</h1>
        <p class="text-muted small">Enter your email to reset your password</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

    <form asp-action="ForgotPassword" method="post">
        <div class="form-floating mb-3">
            <input type="email" name="email" class="form-control" placeholder="Email" required />
            <label>Email</label>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
            <i class="bi bi-arrow-right-circle me-1"></i> Continue
        </button>
    </form>

    <p class="text-center small text-muted mt-4 mb-0">
        <a asp-action="Login" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Back to login</a>
    </p>
</div>