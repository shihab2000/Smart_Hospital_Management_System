@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="text-center mb-4">
        <div class="auth-icon"><i class="bi bi-hospital"></i></div>
        <h1 class="h4 fw-bold mt-3 mb-1">Welcome Back</h1>
        <p class="text-muted small">Sign in to your SHMS account</p>
    </div>

    @if (TempData["RegisterSuccess"] != null)
    {
        <div class="alert alert-success py-2 small">@TempData["RegisterSuccess"]</div>
    }
    @if (TempData["ResetSuccess"] != null)
    {
        <div class="alert alert-success py-2 small">@TempData["ResetSuccess"]</div>
    }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

    <form asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

        <div class="form-floating mb-3">
            <input type="email" name="email" class="form-control" placeholder="Email" required />
            <label>Email</label>
        </div>

        <div class="form-floating mb-3">
            <input type="password" name="password" class="form-control" placeholder="Password" required />
            <label>Password</label>
        </div>

        <div class="d-flex justify-content-end mb-3">
            <a asp-action="ForgotPassword" class="small text-decoration-none">Forgot password?</a>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
        </button>
    </form>

    <p class="text-center small text-muted mt-4 mb-0">
        Don't have an account? <a asp-action="Register" class="fw-semibold text-decoration-none">Register here</a>
    </p>
</div>