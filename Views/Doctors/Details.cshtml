@model SHMS.Models.Doctor

@{
    ViewData["Title"] = "Details";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-circle text-white fw-bold fs-4"
                         style="width:64px;height:64px;background:linear-gradient(135deg, var(--brand-secondary), var(--brand-primary));">
                        @(Model?.Name?.Length > 0 ? Model.Name.Substring(0, 1).ToUpper() : "?")
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold">@Html.DisplayFor(model => model.Name)</h1>
                        <p class="text-muted small mb-0">@(Model?.Department?.Name ?? "No department assigned")</p>
                    </div>
                </div>

                <hr class="mb-4" />

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-envelope me-2"></i>@Html.DisplayNameFor(model => model.Email)
                    </dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-telephone me-2"></i>@Html.DisplayNameFor(model => model.Phone)
                    </dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Phone)</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-building me-2"></i>@Html.DisplayNameFor(model => model.Department)
                    </dt>
                    <dd class="col-sm-8">@(Model?.Department?.Name ?? "No department assigned")</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-clipboard2-pulse me-2"></i>@Html.DisplayNameFor(model => model.Specialization)
                    </dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Specialization)</dd>

                    <dt class="col-sm-4 text-muted fw-normal">
                        <i class="bi bi-circle-fill me-2" style="font-size:.6rem;"></i>@Html.DisplayNameFor(model => model.Availability)
                    </dt>
                    <dd class="col-sm-8">
                        <span class="badge rounded-pill @(Model != null && Model.Availability ? "text-bg-success" : "text-bg-secondary")">
                            @(Model != null && Model.Availability ? "Available" : "Unavailable")
                        </span>
                    </dd>
                </dl>

                <hr class="my-4" />

                <h6 class="fw-bold mb-3"><i class="bi bi-calendar-week me-2"></i>Weekly Schedule</h6>

                @if (Model?.DoctorSchedules != null && Model.DoctorSchedules.Any())
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Day</th>
                                    <th>Start</th>
                                    <th>End</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sch in Model.DoctorSchedules.OrderBy(s => s.DayOfWeek))
                                {
                                    <tr>
                                        <td>@sch.DayOfWeek</td>
                                        <td>@sch.StartTime.ToString(@"hh\:mm")</td>
                                        <td>@sch.EndTime.ToString(@"hh\:mm")</td>
                                        <td class="text-end">
                                            <form asp-controller="Doctors" asp-action="DeleteSchedule" method="post" class="d-inline">
                                                <input type="hidden" name="scheduleId" value="@sch.DoctorScheduleId" />
                                                <input type="hidden" name="doctorId" value="@Model?.DoctorId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-3">No schedule set yet.</p>
                }

                <form asp-controller="Doctors" asp-action="AddSchedule" method="post" class="row g-2 align-items-end mb-4">
                    <input type="hidden" name="doctorId" value="@Model?.DoctorId" />
                    <div class="col-sm-3">
                        <label class="form-label small text-muted">Day</label>
                        <select name="dayOfWeek" class="form-select form-select-sm" required>
                            <option value="">-- Day --</option>
                            <option>Saturday</option>
                            <option>Sunday</option>
                            <option>Monday</option>
                            <option>Tuesday</option>
                            <option>Wednesday</option>
                            <option>Thursday</option>
                            <option>Friday</option>
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label small text-muted">Start Time</label>
                        <input type="time" name="startTime" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label small text-muted">End Time</label>
                        <input type="time" name="endTime" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-sm-3">
                        <button type="submit" class="btn btn-sm btn-primary w-100">
                            <i class="bi bi-plus-lg me-1"></i> Add Slot
                        </button>
                    </div>
                </form>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.DoctorId" class="btn btn-primary flex-fill fw-semibold">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }
</style>