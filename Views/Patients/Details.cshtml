@model SHMS.Models.Patient

@{
    ViewData["Title"] = "Patient Profile";
    var medicalRecords = ViewBag.MedicalRecords as List<SHMS.Models.MedicalRecord>;
    var prescriptions = ViewBag.Prescriptions as List<SHMS.Models.Prescription>;
}

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4 p-md-5">
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center justify-content-center rounded-circle text-white fw-bold fs-4"
                 style="width:64px;height:64px;background:linear-gradient(135deg, var(--brand-secondary), var(--brand-primary));">
                @(Model?.Name?.Length > 0 ? Model.Name.Substring(0, 1).ToUpper() : "?")
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold">@Html.DisplayFor(model => model.Name)</h1>
                <p class="text-muted small mb-0">
                    @Html.DisplayFor(model => model.Gender) · @Model?.DateOfBirth.ToString("dd MMM yyyy")
                    · <span class="badge rounded-pill text-bg-danger-subtle text-danger-emphasis border border-danger-subtle">@(Model?.BloodGroup ?? "—")</span>
                </p>
            </div>
            <div class="ms-auto d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.PatientId" class="btn btn-primary fw-semibold">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-pills mb-4 gap-2" id="patientTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-info" type="button">
            <i class="bi bi-person me-1"></i> Info
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-appointments" type="button">
            <i class="bi bi-calendar-check me-1"></i> Appointments
            <span class="badge rounded-pill text-bg-secondary ms-1">@(Model?.Appointments?.Count ?? 0)</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-records" type="button">
            <i class="bi bi-file-medical me-1"></i> Medical History
            <span class="badge rounded-pill text-bg-secondary ms-1">@(medicalRecords?.Count ?? 0)</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-prescriptions" type="button">
            <i class="bi bi-prescription2 me-1"></i> Prescriptions
            <span class="badge rounded-pill text-bg-secondary ms-1">@(prescriptions?.Count ?? 0)</span>
        </button>
    </li>
</ul>

<div class="tab-content">

    <!-- INFO TAB -->
    <div class="tab-pane fade show active" id="tab-info">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted fw-normal"><i class="bi bi-telephone me-2"></i>Phone</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Phone)</dd>

                    <dt class="col-sm-3 text-muted fw-normal"><i class="bi bi-geo-alt me-2"></i>Address</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Address)</dd>

                    <dt class="col-sm-3 text-muted fw-normal"><i class="bi bi-telephone-plus me-2"></i>Emergency Contact</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.EmergencyContact)</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- APPOINTMENTS TAB -->
    <div class="tab-pane fade" id="tab-appointments">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Doctor</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Reason</th>
                            <th class="pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Appointments != null && Model.Appointments.Any())
                        {
                            @foreach (var appt in Model.Appointments.OrderByDescending(a => a.AppointmentDate))
                            {
                                var statusClass = appt.Status?.ToLower() switch
                                {
                                    "confirmed" => "text-bg-success",
                                    "completed" => "text-bg-primary",
                                    "cancelled" => "text-bg-danger",
                                    "pending" => "text-bg-warning",
                                    _ => "text-bg-secondary"
                                };
                                <tr>
                                    <td class="ps-4 fw-semibold">@(appt.Doctor?.Name ?? "—")</td>
                                    <td>@appt.AppointmentDate.ToString("dd MMM yyyy")</td>
                                    <td>@appt.AppointmentTime.ToString(@"hh\:mm")</td>
                                    <td class="text-muted">@appt.Reason</td>
                                    <td class="pe-4">
                                        <span class="badge rounded-pill @statusClass">@appt.Status</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No appointments found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- MEDICAL HISTORY TAB -->
    <div class="tab-pane fade" id="tab-records">
        @if (medicalRecords != null && medicalRecords.Any())
        {
            @foreach (var record in medicalRecords)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h6 class="fw-bold mb-0">@(record.Doctor?.Name ?? "—")</h6>
                                <span class="text-muted small">@record.RecordDate.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                        <dl class="row mb-0 small">
                            <dt class="col-sm-3 text-muted fw-normal">Symptoms</dt>
                            <dd class="col-sm-9">@record.Symptoms</dd>
                            <dt class="col-sm-3 text-muted fw-normal">Diagnosis</dt>
                            <dd class="col-sm-9">@record.Diagnosis</dd>
                            <dt class="col-sm-3 text-muted fw-normal">Treatment</dt>
                            <dd class="col-sm-9">@record.Treatment</dd>
                            @if (!string.IsNullOrEmpty(record.MedicalNotes))
                            {
                                <dt class="col-sm-3 text-muted fw-normal">Notes</dt>
                                <dd class="col-sm-9">@record.MedicalNotes</dd>
                            }
                        </dl>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="text-center text-muted py-5">
                    <i class="bi bi-file-medical display-6 d-block mb-2"></i>
                    No medical history found.
                </div>
            </div>
        }
    </div>

    <!-- PRESCRIPTIONS TAB -->
    <div class="tab-pane fade" id="tab-prescriptions">
        @if (prescriptions != null && prescriptions.Any())
        {
            @foreach (var rx in prescriptions)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h6 class="fw-bold mb-0">@(rx.Doctor?.Name ?? "—")</h6>
                                <span class="text-muted small">@rx.PrescriptionDate.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                        @if (rx.PrescriptionItems != null && rx.PrescriptionItems.Any())
                        {
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr class="small text-muted">
                                        <th>Medicine</th>
                                        <th>Dosage</th>
                                        <th>Duration</th>
                                        <th>Instructions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in rx.PrescriptionItems)
                                    {
                                        <tr class="small">
                                            <td class="fw-semibold">@(item.Medicine?.MedicineName ?? "—")</td>
                                            <td>@item.Dosage</td>
                                            <td>@item.Duration</td>
                                            <td>@item.Instructions</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        @if (!string.IsNullOrEmpty(rx.Notes))
                        {
                            <p class="small text-muted mb-0 mt-2"><i class="bi bi-info-circle me-1"></i>@rx.Notes</p>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="text-center text-muted py-5">
                    <i class="bi bi-prescription2 display-6 d-block mb-2"></i>
                    No prescriptions found.
                </div>
            </div>
        }
    </div>

</div>

<style>
    .nav-pills .nav-link {
        color: #334155;
        font-weight: 500;
        border-radius: 10px;
    }

    .nav-pills .nav-link.active {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        color: #fff;
    }

    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }
</style>