@model SHMS.Models.Invoice

@{
    ViewData["Title"] = "Create";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center justify-content-center rounded-3 text-white"
                         style="width:48px;height:48px;background:linear-gradient(135deg, var(--brand-secondary), var(--brand-primary));">
                        <i class="bi bi-receipt fs-5"></i>
                    </div>
                    <div>
                        <h1 class="h4 mb-0 fw-bold">Generate Invoice</h1>
                        <p class="text-muted small mb-0">Select a patient to auto-fill their medicine and lab charges.</p>
                    </div>
                </div>

                <hr class="mb-4" />

                <form asp-action="Create" id="invoiceForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-floating">
                                <select asp-for="PatientId" class="form-select" asp-items="ViewBag.PatientId" id="patientSelect">
                                    <option value="">-- Select Patient --</option>
                                </select>
                                <label asp-for="PatientId"></label>
                                <span asp-validation-for="PatientId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="InvoiceDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                <label asp-for="InvoiceDate"></label>
                                <span asp-validation-for="InvoiceDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="ConsultationFee" type="number" step="0.01" class="form-control" placeholder="Consultation Fee" value="500" id="consultationFee" />
                                <label asp-for="ConsultationFee"></label>
                                <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="MedicineCharge" type="number" step="0.01" class="form-control" id="medicineCharge" readonly />
                                <label asp-for="MedicineCharge"></label>
                            </div>
                            <div class="form-text small">Auto-filled from patient's medicine sales.</div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="LabCharge" type="number" step="0.01" class="form-control" id="labCharge" readonly />
                                <label asp-for="LabCharge"></label>
                            </div>
                            <div class="form-text small">Auto-filled from patient's lab tests.</div>
                        </div>
                    </div>

                    <div class="alert alert-light border mt-4 d-flex justify-content-between align-items-center">
                        <span class="fw-semibold text-muted">Total Amount</span>
                        <span class="fs-5 fw-bold" id="totalAmountDisplay">৳0.00</span>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary flex-fill py-2 fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Generate Invoice
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-2">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    </div>
                </form>

            </div>
        </div>

        <div class="text-center mt-3">
            <a asp-action="Index" class="text-decoration-none small">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
        border: none;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        opacity: .92;
        background: linear-gradient(90deg, var(--brand-secondary), var(--brand-primary));
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 .2rem rgba(13, 148, 136, .15);
    }

    .form-control[readonly] {
        background-color: #f8fafc;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        const patientSelect = document.getElementById('patientSelect');
        const consultationFee = document.getElementById('consultationFee');
        const medicineCharge = document.getElementById('medicineCharge');
        const labCharge = document.getElementById('labCharge');
        const totalDisplay = document.getElementById('totalAmountDisplay');

        function updateTotal() {
            const c = parseFloat(consultationFee.value) || 0;
            const m = parseFloat(medicineCharge.value) || 0;
            const l = parseFloat(labCharge.value) || 0;
            totalDisplay.textContent = '৳' + (c + m + l).toFixed(2);
        }

        patientSelect.addEventListener('change', async function () {
            const patientId = this.value;
            if (!patientId) {
                medicineCharge.value = '';
                labCharge.value = '';
                updateTotal();
                return;
            }

            try {
                const response = await fetch(`@Url.Action("GetPatientCharges", "Invoices")?patientId=${patientId}`);
                const data = await response.json();
                medicineCharge.value = data.medicineCharge.toFixed(2);
                labCharge.value = data.labCharge.toFixed(2);
            } catch (err) {
                medicineCharge.value = '0.00';
                labCharge.value = '0.00';
            }

            updateTotal();
        });

        consultationFee.addEventListener('input', updateTotal);
    </script>
}